# Copy this file to .env and fill in your own values

# Port the server runs on (Render/Railway set this automatically in production)
PORT=4000

# Allowed origin for your frontend (set this to your deployed frontend URL)
FRONTEND_ORIGIN=http://localhost:5500

# Free tier: how many distinct strangers a non-paying user can talk to
FREE_MATCH_LIMIT=5

# Paid tier: how many distinct strangers a paying member can talk to
PAID_MATCH_LIMIT=50

# How much a membership costs, for display purposes only (in PHP)
MEMBERSHIP_PRICE_PHP=100

# --- PayMongo (optional, for automatic GCash payment + auto-upgrade) ---
# Get these from https://dashboard.paymongo.com/developers
# Leave blank to fall back to "manual GCash" mode (you upgrade members by hand)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Your GCash details, shown to users in "manual GCash" fallback mode
GCASH_NAME=Your Name
GCASH_NUMBER=09XXXXXXXXX

# --- WebRTC TURN server (optional but recommended, see README) ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
